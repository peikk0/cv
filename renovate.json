{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":assignee(peikk0)",
    ":automergeAll",
    ":disableRateLimiting",
    ":label(dependencies)",
    ":maintainLockFilesWeekly",
    ":npm",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["puppeteer", "ghcr.io/puppeteer/puppeteer"],
      "groupName": "puppeteer"
    }
  ]
}
